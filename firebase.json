{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "README.md",
      "SECURITY.md",
      "scripts/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
      { "source": "/parkingpilotai", "destination": "/parkingpilotai/index.html" },
      { "source": "/parkingpilotai/privacy", "destination": "/parkingpilotai/privacy.html" },
      { "source": "/parkingpilotai/terms", "destination": "/parkingpilotai/terms.html" },
      { "source": "/parkingpilotai/refund", "destination": "/parkingpilotai/refund.html" },
      { "source": "/parkingpilotai/contact", "destination": "/parkingpilotai/contact.html" }
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=3600" }]
      },
      {
        "source": "content/**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
